                    "meta": {
                        "h1": "Vancouver Apartments, Condos and Houses for Rent",
                        "title": "Rentals.ca Vancouver Apartments, Condos and Houses For Rent",
                        "description": "Finding a place to call home in Vancouver BC has never been so easy. Quickly find your new Apartment, Condo or House using our easy-to-use map-based search",
                        "url": "https://rentals.ca/vancouver?h3=8628de8d7ffffff",
                        "canonical_url": "https://rentals.ca/vancouver",
                        "locales": {
                            "fr": "https://rentals.ca/fr/a-louer-vancouver?h3=8628de8d7ffffff",
